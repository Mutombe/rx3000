# RX3000 backend configuration — copy to .env and fill in
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./rx3000.db

# Pharmacy identity
PHARMACY_NAME=RX3000 Pharmacy
PHARMACY_REG_NO=Y123456
VAT_RATE=0.15
CURRENCY=R

# Claude AI (https://platform.claude.com) — leave blank to disable AI features
ANTHROPIC_API_KEY=

# Email reminders (SMTP) — leave blank to log to console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=pharmacy@example.com

# SMS gateway — HTTP GET template with {phone} and {message} placeholders.
# Leave blank to log to console instead of sending.
SMS_GATEWAY_URL=
