__pycache__/
*.pyc
backend/.env
backend/rx3000.db
backend/backups/
frontend/node_modules/
frontend/dist/

# The database and everything that travels with it. `rx3000.db` alone is not
# enough: SQLite in WAL mode keeps recent transactions in the -wal file, so
# committing that ships real patient records into git history — where deleting
# them later does not remove them.
backend/rx3000.db*
backend/*.db
# Also at the root. A QA script with a relative SQLite path, run from the wrong
# directory, makes an empty database here rather than failing — and one got
# committed before this line existed.
/rx3000.db*
/*.db
backend/*.db-shm
backend/*.db-wal
*.before-repair

# Vite writes these while resolving its config; they are build scratch.
frontend/vite.config.ts.timestamp-*

# Rust build output. Hundreds of megabytes of compiled crates that rebuild from
# source; nothing here belongs in a repository.
desktop/src-tauri/target/

desktop/src-tauri/build.log
desktop/src-tauri/bundle.log
qa/out/

# Server logs. These were committed by accident and had reached 2.2MB of
# stack traces and request lines — they change on every run, so they turn every
# commit into a diff of yesterday's traffic. Worth keeping on disk, never in git.
backend/uvicorn.err.log
backend/uvicorn.out.log
backend/*.log

# The frozen backend and PyInstaller's working directory. Built by CI per
# platform, never committed: a fifty-eight megabyte binary in git is a
# repository nobody can clone over a Zimbabwean line.
backend/build/
backend/dist/

# QA harnesses build throwaway databases; SCRATCH normally puts them
# elsewhere, but a run without it should not offer them for commit.
*.sqlite
